# Copy this file to ".env" and fill in your own values. NEVER commit .env.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=estatehub

# Auth (use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email notifications (optional). Leave SMTP_HOST empty to turn emails off: the app still works and
# in-app notifications (the bell icon) are always on. Test your settings with:  npm run mail:test you@example.com
# Easy options for development: a free Ethereal account (https://ethereal.email, fake inbox, nothing is delivered),
# Mailtrap, or Gmail with an "app password" (host smtp.gmail.com, port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EstateHub <no-reply@estatehub.local>"

# AI assistant (Phase 5) - optional; rule-based fallback is used when empty
LLM_API_KEY=
